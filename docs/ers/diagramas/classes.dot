digraph C {
  graph [rankdir=TB, fontname="Liberation Sans", nodesep=0.35, ranksep=0.6, pad=0.3, bgcolor="white"]
  node [shape=plain, fontname="Liberation Sans", fontsize=14]
  edge [fontname="Liberation Sans", fontsize=12, color="#333333", arrowsize=0.9]
  partida [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«utility»</I><BR/><B>ControleDaPartida</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+startGame()<BR ALIGN="LEFT"/>+comecarPartida()<BR ALIGN="LEFT"/>+continueGame()<BR ALIGN="LEFT"/>+sortearFases()<BR ALIGN="LEFT"/>+sortearVariantes()<BR ALIGN="LEFT"/>+resetGame()<BR ALIGN="LEFT"/>+apagarProgresso()<BR ALIGN="LEFT"/>+perguntar(opcoes)<BR ALIGN="LEFT"/>+mostrarFim()<BR ALIGN="LEFT"/>+jogarDeNovo()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  etapas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«utility»</I><BR/><B>ControleDasEtapas</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+enterLevel(i)<BR ALIGN="LEFT"/>+setupP1()<BR ALIGN="LEFT"/>+setupP2()<BR ALIGN="LEFT"/>+setupP2Sombra()<BR ALIGN="LEFT"/>+setupP2Traco()<BR ALIGN="LEFT"/>+setupP3()<BR ALIGN="LEFT"/>+setupP4()<BR ALIGN="LEFT"/>+buildOptions(config)<BR ALIGN="LEFT"/>+responder(opt, card, pontos, ...)<BR ALIGN="LEFT"/>+avancarDepoisDoAcerto(opt, prox)<BR ALIGN="LEFT"/>+charadaDe(animal)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  exploracao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«utility»</I><BR/><B>Exploração</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+startLoop()<BR ALIGN="LEFT"/>+movePlayer(q)<BR ALIGN="LEFT"/>+moverNaTrilha(dx, dy)<BR ALIGN="LEFT"/>+escorregarNaCurva(sx, sy)<BR ALIGN="LEFT"/>+naTrilha(x, y)<BR ALIGN="LEFT"/>+snapCamera(imediato)<BR ALIGN="LEFT"/>+drawMini()<BR ALIGN="LEFT"/>+drawProg()<BR ALIGN="LEFT"/>+buildPortals()<BR ALIGN="LEFT"/>+checkNear()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  config [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«utility»</I><BR/><B>Configurações</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toggleCfg()<BR ALIGN="LEFT"/>+setNarracao(ligada)<BR ALIGN="LEFT"/>+setVelocidade(v)<BR ALIGN="LEFT"/>+setSons(ligados)<BR ALIGN="LEFT"/>+salvarConfig()<BR ALIGN="LEFT"/>+carregarConfig()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  estado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«singleton»</I><BR/><B>EstadoDoJogo (G)</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+screen<BR ALIGN="LEFT"/>+idx<BR ALIGN="LEFT"/>+fase<BR ALIGN="LEFT"/>+score<BR ALIGN="LEFT"/>+ptsCaverna<BR ALIGN="LEFT"/>+combo<BR ALIGN="LEFT"/>+fases<BR ALIGN="LEFT"/>+variantes<BR ALIGN="LEFT"/>+pergunta<BR ALIGN="LEFT"/>+done<BR ALIGN="LEFT"/>+firstTry<BR ALIGN="LEFT"/>+muted<BR ALIGN="LEFT"/>+travado<BR ALIGN="LEFT"/>+px, py, vx, vy<BR ALIGN="LEFT"/>+camx, camy<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]
  persist [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«utility»</I><BR/><B>Persistência</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+save()<BR ALIGN="LEFT"/>+load()<BR ALIGN="LEFT"/>+temProgresso()<BR ALIGN="LEFT"/>+oQueSePerde()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  audio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«singleton»</I><BR/><B>CanalDeAudio (AUDIO)</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+fila<BR ALIGN="LEFT"/>+token<BR ALIGN="LEFT"/>+repetir<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+tocarSequencia(itens, rep)<BR ALIGN="LEFT"/>+seguirFila(token)<BR ALIGN="LEFT"/>+silenciarTudo()<BR ALIGN="LEFT"/>+tocarSomAgora(animal, el, fim)<BR ALIGN="LEFT"/>+playBeepSequence(seq)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  voz [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«singleton»</I><BR/><B>Narração (VOZ)</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ligada<BR ALIGN="LEFT"/>+velocidade<BR ALIGN="LEFT"/>+voz<BR ALIGN="LEFT"/>+ultimo<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+escolherVoz()<BR ALIGN="LEFT"/>+falarAgora(texto, opts, fim)<BR ALIGN="LEFT"/>+narrar(texto, opcoes)<BR ALIGN="LEFT"/>+repetirNarracao()<BR ALIGN="LEFT"/>+listaDeOpcoes(gridId)<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  catalogo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><I>«utility»</I><BR/><B>Catálogo<BR/>(ANIMAIS, PERGUNTAS)</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+todosAnimais()<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  animal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Animal</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+id<BR ALIGN="LEFT"/>+nome<BR ALIGN="LEFT"/>+artigo<BR ALIGN="LEFT"/>+emoji<BR ALIGN="LEFT"/>+som<BR ALIGN="LEFT"/>+tom<BR ALIGN="LEFT"/>+onomatopeia<BR ALIGN="LEFT"/>+charadas<BR ALIGN="LEFT"/>+audiodescricao<BR ALIGN="LEFT"/>+libras<BR ALIGN="LEFT"/>+imagem<BR ALIGN="LEFT"/>+cor<BR ALIGN="LEFT"/>+habitat<BR ALIGN="LEFT"/>+tracos<BR ALIGN="LEFT"/>+curiosidade<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]
  pergunta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Pergunta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+traco<BR ALIGN="LEFT"/>+icone<BR ALIGN="LEFT"/>+texto<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]
  mapa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Mapa (MAPA)</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+nome<BR ALIGN="LEFT"/>+badge<BR ALIGN="LEFT"/>+imagem<BR ALIGN="LEFT"/>+arvore<BR ALIGN="LEFT"/>+inicio<BR ALIGN="LEFT"/>+cavernas<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]
  ponto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Ponto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+x<BR ALIGN="LEFT"/>+y<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]
  trilhas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Trilhas (TRILHAS)</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+colunas<BR ALIGN="LEFT"/>+linhas<BR ALIGN="LEFT"/>+larguraBase<BR ALIGN="LEFT"/>+alturaBase<BR ALIGN="LEFT"/>+bits<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>]
  { rank=same; partida; etapas; exploracao }
  { rank=same; config; estado; persist }
  { rank=same; audio; voz; catalogo }
  { rank=same; animal; pergunta; mapa; trilhas }
  edge [style=dashed, arrowhead=vee]
  partida -> estado; partida -> persist; partida -> catalogo
  etapas -> estado; etapas -> audio; etapas -> voz; etapas -> catalogo
  exploracao -> estado; exploracao -> mapa; exploracao -> trilhas
  config -> voz; config -> estado
  audio -> voz
  persist -> estado [constraint=false]
  edge [style=solid, arrowhead=none]
  catalogo -> animal [arrowtail=odiamond, dir=back, taillabel="1 ", headlabel="4..* "]
  catalogo -> pergunta [arrowtail=odiamond, dir=back, taillabel="1 ", headlabel="* "]
  mapa -> ponto [arrowtail=diamond, dir=back, taillabel="1 ", headlabel="8 "]
}