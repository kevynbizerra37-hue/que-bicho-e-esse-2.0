digraph M {
  graph [rankdir=TB, fontname="Liberation Sans", nodesep=0.5, ranksep=0.7, pad=0.3, bgcolor="white"]
  node [shape=plain, fontname="Liberation Sans", fontsize=14]
  edge [fontname="Liberation Sans", fontsize=12.5, color="#333333", arrowsize=0.9, labelfontsize=12.5, labeldistance=1.6]
  mapa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Mapa</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">nome<BR ALIGN="LEFT"/>imagem<BR ALIGN="LEFT"/>pontoInicial<BR ALIGN="LEFT"/>posicaoDaArvore<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  malha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Malha de Trilhas</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">colunas<BR ALIGN="LEFT"/>linhas<BR ALIGN="LEFT"/>tamanhoDaCelula<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  caverna [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Caverna</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">numero<BR ALIGN="LEFT"/>posicao<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  partida [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Partida</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">placarDeCoroas<BR ALIGN="LEFT"/>coroasDaCavernaEmCurso<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  cpartida [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Caverna da Partida</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">variante<BR ALIGN="LEFT"/>concluida<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  etapa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Etapa</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">tipo<BR ALIGN="LEFT"/>acertouDePrimeira<BR ALIGN="LEFT"/>coroas<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  animal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Animal</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">nome<BR ALIGN="LEFT"/>artigo<BR ALIGN="LEFT"/>onomatopeia<BR ALIGN="LEFT"/>audiodescricao<BR ALIGN="LEFT"/>bioma<BR ALIGN="LEFT"/>curiosidade<BR ALIGN="LEFT"/>ilustracao<BR ALIGN="LEFT"/>som<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  traco [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Traço</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">nome<BR ALIGN="LEFT"/>valor<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  pergunta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Pergunta de Característica</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">icone<BR ALIGN="LEFT"/>texto<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  charada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Charada</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">texto<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  pref [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#222222"><TR><TD><B>Preferências de Acessibilidade</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">narracaoLigada<BR ALIGN="LEFT"/>velocidadeDaVoz<BR ALIGN="LEFT"/>sonsLigados<BR ALIGN="LEFT"/></TD></TR></TABLE>>]
  mapa -> caverna [dir=back, arrowtail=diamond, arrowhead=none, label="contém", taillabel="1", headlabel="6"]
  mapa -> malha [arrowhead=none, label="restringe o\nmovimento", taillabel="1", headlabel="1"]
  partida -> cpartida [dir=back, arrowtail=diamond, arrowhead=none, label="sorteia", taillabel="1", headlabel="6"]
  cpartida -> caverna [arrowhead=vee, label="ocupa", taillabel="*", headlabel="1"]
  cpartida -> etapa [dir=back, arrowtail=diamond, arrowhead=none, label="compõe", taillabel="1", headlabel="3"]
  etapa -> animal [arrowhead=vee, label="alvo", taillabel="*", headlabel="1"]
  etapa -> animal [arrowhead=vee, label="distratores", taillabel="*", headlabel="3"]
  etapa -> pergunta [arrowhead=vee, label="usa", taillabel="*", headlabel="0..1"]
  etapa -> charada [arrowhead=vee, label="usa", taillabel="*", headlabel="0..1"]
  animal -> traco [dir=back, arrowtail=diamond, arrowhead=none, label="possui", taillabel="1", headlabel="9"]
  animal -> charada [dir=back, arrowtail=diamond, arrowhead=none, label="possui", taillabel="1", headlabel="1..*"]
  pergunta -> traco [arrowhead=vee, label="avalia", taillabel="*", headlabel="1"]
  partida -> pref [arrowhead=vee, label="aplica", taillabel="*", headlabel="1"]
}